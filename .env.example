# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (defaults to local or in-memory mock if not configured)
MONGODB_URI=mongodb://localhost:27017/trao_interview_prep

# JWT Secret for User Authentication
JWT_SECRET=super_secret_jwt_key_trao_prep_kit_2026

# LLM Provider Configuration
# Supported providers: "gemini" | "groq" | "openrouter" | "mock"
LLM_PROVIDER=gemini

# Google Gemini API Key (get a free key at https://aistudio.google.com/)
GEMINI_API_KEY=

# Groq API Key (alternative genuine free tier: https://console.groq.com/)
GROQ_API_KEY=

# Optional: OpenRouter API Key
OPENROUTER_API_KEY=

# Optional: Preferred model override (e.g. gemini-1.5-flash, gemini-2.0-flash, llama-3.3-70b-versatile)
LLM_MODEL=gemini-2.0-flash

# Crawler Settings
CRAWLER_MAX_PAGES=5
CRAWLER_TIMEOUT_MS=8000
CRAWLER_USER_AGENT=TraoPrepBot/1.0 (+https://github.com/trao/interview-prep)
